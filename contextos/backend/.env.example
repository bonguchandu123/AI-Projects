NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Docker Postgres from database/docker-compose.yml (host port 5433)
DATABASE_URL=postgres://contextos:contextos_dev_only@127.0.0.1:5433/contextos
DB_POOL_MAX=10
LOG_LEVEL=info
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal

# Gemini (optional). Without a key, extraction uses the labelled deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Shared secret configured on the Odysseus webhook (HMAC-SHA256 of the raw body).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ODYSSEUS_WEBHOOK_SECRET=
ODYSSEUS_DEFAULT_PROJECT=Odysseus Inbox
JOB_WORKER_ENABLED=true
